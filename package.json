{
  "name": "examgrid",
  "version": "1.0.0",
  "description": "ExamGrid FullStack Project",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "build": "npm run build --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "db:init": "npm run db:init --prefix server",
    "install-server": "npm ci --prefix server",
    "install:all": "npm ci --prefix server && npm ci --prefix client --include=dev",
    "test": "node --test server/test/*.test.js"
  },
  "engines": {
    "node": "24.x"
  }
}
