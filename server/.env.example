# Neon (yoki lokal Postgres) ulanish satri
# Neon: postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Lokal: postgresql://postgres:PASSWORD@localhost:5432/examgrid_db
DATABASE_URL=

# Schema yaratish uchun Neon direct connection (host ichida -pooler bo'lmaydi).
# Bo'sh bo'lsa db:init DATABASE_URL dan foydalanadi.
DATABASE_URL_UNPOOLED=

# JWT tokenlarni imzolash uchun kamida 32 belgili tasodifiy satr
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Faqat `npm run db:init` uchun: birinchi superadmin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

PORT=5000
